# Copy to terraform.tfvars (git-ignored) and fill in. No secrets belong here.
subscription_id              = "00000000-0000-0000-0000-000000000000"
gitlab_url                   = "https://gitlab.example.com"
manager_admin_ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

location    = "eastus"
name_prefix = "glrun"

# Lock Key Vault data plane to your egress IP (curl -s https://ifconfig.me).
# key_vault_allowed_ip_cidrs = ["203.0.113.10/32"]

use_spot       = false
enable_windows = true

linux_max_instances   = 3
windows_max_instances = 1
